# HQ Galaxy companion server — copy to .env and fill in what you use.
# .env is gitignored; secrets never reach the browser.

# Port for the dashboard (default 4560)
#PORT=4560

# Where to listen. Default 127.0.0.1 = this machine only (laptop use).
# On a home server (Proxmox etc.) set 0.0.0.0 so other devices can reach it —
# and ALWAYS set HQ_PASSWORD when you do.
#HOST=0.0.0.0

# Password for the whole dashboard (login page + API). Required for HOST=0.0.0.0.
#HQ_PASSWORD=pick-something-long

# Folder where your projects live / where new projects get created.
# Defaults to the parent folder of this repo.
#PROJECTS_ROOT=/home/you/projects

# Stripe secret key -> live subs / MRR / 30d revenue in Telemetry
#STRIPE_SECRET_KEY=sk_live_...

# Vercel token -> deploy states on the map (can also be pasted in the UI settings)
#VERCEL_TOKEN=...
